# ═══════════════════════════════════════════════════════════════
# tiny-claw 配置模板
#
# 用法：
#   cp .env.example .env      然后填入真实值
#
# 说明：
#   - .env 已被 .gitignore 忽略，不会提交。（提交前请确认！）
#   - 进程里已 export 的同名环境变量优先级更高（load_dotenv(override=False)），
#     所以 CI 里 export 的值不会被本地 .env 覆盖。
#   - 所有 TINY_CLAW_ 前缀项都可以不填，不填即用代码里的默认值。
# ═══════════════════════════════════════════════════════════════


# ───────────────────────────────────────────────────────────────
# 1. 模型凭据（必填，否则启动即退出）
# ───────────────────────────────────────────────────────────────

# OpenAI 协议走这个 key（--provider openai）
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxx

# Anthropic 协议走这个 key（--provider anthropic）。
# 留空则自动复用 DEEPSEEK_API_KEY —— DeepSeek 官方提供 Anthropic 协议端点，
# 同一个 key 可驱动两套协议，这是本项目「同模型双协议对照」验证的基础。
ANTHROPIC_API_KEY=

# 端点。一般不用改；换其他兼容厂商时改这里即可。
# DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
# ANTHROPIC_BASE_URL=https://api.deepseek.com/anthropic


# ───────────────────────────────────────────────────────────────
# 2. 模型参数
# ───────────────────────────────────────────────────────────────

# 两套协议共用同一个模型，是「同模型双协议」对照实验的前提。
# 换模型只改这一处，CLI 与 benchmark 会同步生效。
# 可选：deepseek-v4-flash（默认） / deepseek-v4-pro / deepseek-reasoner
TINY_CLAW_MODEL=deepseek-v4-flash

# 单次输出上限。Anthropic 协议下这是必填字段，OpenAI 侧可选。
TINY_CLAW_MAX_TOKENS=4096

# 慢思考预算占 max_tokens 的比例。
# 原生 Anthropic 要求 budget_tokens < max_tokens；DeepSeek 端点会忽略此字段，
# 只认 thinking.type="enabled"。
TINY_CLAW_THINKING_BUDGET_RATIO=0.5


# ───────────────────────────────────────────────────────────────
# 3. 引擎参数
# ───────────────────────────────────────────────────────────────

# 单任务最大推理轮次，超过则强制退出（防跑飞）
TINY_CLAW_MAX_TURNS=30

# 工具并发度（主引擎 / 子智能体）
TINY_CLAW_MAX_PARALLEL_TOOLS=5
TINY_CLAW_SUBAGENT_PARALLEL_TOOLS=3

# 交给压缩器判断的窗口大小
# ⚠️ 必须大于下面的 TINY_CLAW_RETAIN_LAST_*：否则所有消息都落在「保护窗口」内，
# 压缩器的「远期淘汰档」永不触发，等于静默退化成只会掐头去尾。
TINY_CLAW_WORKING_MEMORY_LIMIT=20

# ── System Reminders：运行时把引擎状态回灌给模型 ──
# 三条约束缺一不可，否则提醒会变成噪声：冷却（同类不连发）、限流（单轮上限）、
# 不写 Session（每轮重算，避免累积成历史垃圾并污染成本统计）。
TINY_CLAW_REMINDER_COOLDOWN_TURNS=3
TINY_CLAW_REMINDER_MAX_PER_TURN=2
# 上下文用量达到压缩阈值的该比例时，提醒模型「该把进度外部化到文件了」
TINY_CLAW_REMINDER_CONTEXT_PRESSURE=0.8
# 剩余轮数少于该值时提醒收敛（默认 5，配合 MAX_TURNS=30 即第 26 轮起）
TINY_CLAW_REMINDER_TURN_WARN_REMAINING=5

# ───────────────────────────────────────────────────────────────
# MCP 客户端（可选能力，见 docs/MCP_INTEGRATION_PLAN.md）
# 依赖装在 extra 里：pip install -e ".[mcp]"
# ───────────────────────────────────────────────────────────────
# 总开关。关闭后完全不读配置文件、不拉子进程
TINY_CLAW_MCP_ENABLED=true

# server 配置文件（社区 mcpServers 格式）。真实文件含机器本地绝对路径，不入库；
# 模板见仓库根的 mcp.json.example
TINY_CLAW_MCP_CONFIG=mcp.json

# 连接 + initialize 超时（秒）。给得宽是因为 stdio server 常用 npx 拉起，
# 启动耗时极不稳定：实测冷启动 48.8s、热启动 4.7~14s，异常时遇过 >240s 不返回。
# 超时不会阻塞启动（该 server 被跳过），但会少掉这批工具 —— 日志里有 ERROR 级播报
TINY_CLAW_MCP_CONNECT_TIMEOUT=120

# 额外注入子进程 PATH 的目录（冒号分隔，多个用 : 连接）。
# ⚠️ 这一项经常是必需的：node/npx 常不在默认 PATH 里（如 nvm、托管环境的
# binaries 目录），不补的话连接失败且只报 "No such file or directory"，
# 极难定位。例：
#   TINY_CLAW_MCP_EXTRA_PATH=/Users/you/.nvm/versions/node/v22.22.2/bin
TINY_CLAW_MCP_EXTRA_PATH=

# 单次工具调用超时（秒），交给 SDK 的 read_timeout_seconds。
# 与连接超时分开：连接慢通常是 npx 拉包，调用慢通常是 server 卡住
TINY_CLAW_MCP_CALL_TIMEOUT=60

# 单个 MCP 工具返回内容的字符上限（默认 8000，与 read_file 同口径）。
# 必要性：MCP 可返回 base64 编码的图片/音频块，不截断会直接撑爆上下文
TINY_CLAW_MCP_MAX_OUTPUT_CHARS=8000

# 上下文压缩阈值（token 口径，见 src/tiny_claw/context/tokens.py）
# 2026-09-09 重标定（benchmark 语料 + 离线重放，复现见 tools/replay_thresholds.py）：
#   - 估算系数按实测校准修正（旧系数低估 1.86 倍），阈值数字等比重标定（×4），
#     触发行为与旧版近似等价（<3% 偏差）。
#   - 观察负载上下文峰值 est=1797，旧阈值 8000 从未触发——调参靠数据不靠感觉。
#   - 新阈值对应真实 ~30k/60k token，距 1M 窗口 25% 安全水位仍有 4~8 倍余量。
TINY_CLAW_COMPACT_TOKENS_THINKING=32000
TINY_CLAW_COMPACT_TOKENS_NORMAL=16000
TINY_CLAW_RETAIN_LAST_THINKING=10
TINY_CLAW_RETAIN_LAST_NORMAL=6

# 层级关系（已被上面这组数字满足）：
# 上面是 token 口径，下面的 TINY_CLAW_READ_MAX_CHARS 是字符口径。
# 中文最坏情况 8000 字符 ≈ 8001 token，必须小于 NORMAL 阈值——
# 否则「读一个文件就触发全局压缩」。再调请保持该关系并重跑 benchmark。


# ───────────────────────────────────────────────────────────────
# 4. 工具参数
# ───────────────────────────────────────────────────────────────

# read_file 单次返回的最大字符数（字符口径，不是字节）。
# 超过则触发输出卸载：写入 .claw/offload/ 并返回「头尾预览 + 路径」。
TINY_CLAW_READ_MAX_CHARS=8000

# 卸载时头尾各预览的行数
TINY_CLAW_PREVIEW_LINES=30

# 卸载目录（相对工作区，子 agent 同 work_dir 可读到）
TINY_CLAW_OFFLOAD_DIR=.claw/offload

# bash 工具：单次输出字符上限与超时秒数。
# ⚠️ bash 超阈值是硬丢弃（不像 read_file 会卸载落盘），超出部分永久丢失。
TINY_CLAW_BASH_MAX_OUTPUT=8000
TINY_CLAW_BASH_TIMEOUT=30


# ───────────────────────────────────────────────────────────────
# 5. 飞书（--mode feishu 时才需要）
# ───────────────────────────────────────────────────────────────

FEISHU_APP_ID=
FEISHU_APP_SECRET=


# ───────────────────────────────────────────────────────────────
# 6. 可观测性
# ───────────────────────────────────────────────────────────────

# ⚠️ 默认 true 是沿用历史行为。未配置 LANGSMITH_API_KEY 且不想联网，请设 false。
LANGSMITH_TRACING=true
LANGSMITH_PROJECT=tiny-claw
LANGSMITH_API_KEY=

# 成本统计单价（元/百万 token）。
# PRICING 表已收录 v4 系列（闲时未命中价，2026-09-09 核对自官方定价页）：
#   deepseek-v4-flash       输入 1.5 / 输出 4.5（2026-09-10 12:00 起降为 1.0 / 4.0）
#   deepseek-v4-pro         输入 4.5 / 输出 13.5
# 注意：真实扣费通常更低——缓存命中仅 0.05 元/百万（Agent 循环命中率高），
#       高峰时段（工作日 9:00-12:00、14:00-18:00）则翻倍。
# 模型不在表内时成本统计为 0 并打 WARNING；想让数字准确就在这里补单价。
# TINY_CLAW_PRICE_INPUT=1.5
# TINY_CLAW_PRICE_OUTPUT=4.5
